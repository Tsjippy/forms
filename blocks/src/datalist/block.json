	"viewScript": "file:./view.js",
	"attributes": {
		"id": {
			"type": "string",
			"default": ""
		},
		"options": {
			"type": "string",
			"default": ""
		},
		"options_dynamic": {
			"type": "string",
			"default": ""
		}
	}
}
