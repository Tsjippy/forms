{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tsjippy-forms/datalist",
	"version": "0.1.0",
	"title": "Datalist",
	"category": "form-elements",
	"icon": "forms",
	"description": "Datalist to be added to an form input",
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "tsjippy",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
