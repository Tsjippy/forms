{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tsjippy-forms/input",
	"version": "0.1.0",
	"title": "Form Input",
	"category": "form-elements",
	"icon": "forms",
	"description": "Input element for a form",
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "tsjippy",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"attributes": {
		"type": {
			"type": "string",
			"default": ""
		},
		"name": {
			"type": "string",
			"default": ""
		},
		"value": {
			"type": "string",
			"default": ""
		},
		"inputAttributes": {
			"type": "object",
			"default": {}
		},
		"ariaAttributes": {
			"type": "boolean",
			"default": false
		},
		"selectable_options": {
			"type": "string",
			"default": ""
		},
		"selectable_options_dynamic": {
			"type": "string",
			"default": ""
		},
		"dynamic_value": {
			"type": "string",
			"default": ""
		},
		"add_button_content": {
			"type": "string",
			"default": "+"
		},
		"remove_button_content": {
			"type": "string",
			"default": "-"
		},
		"multiple": {
			"type": "boolean",
			"default": false
		},
		"required": {
			"type": "boolean",
			"default": false
		},
		"hasLabelParent": {
			"type": "boolean",
			"default": false
		},
		"hide": {
			"type": "boolean",
			"default": false
		},
		"reminders": {
			"type": "array",
			"default": []
		}
	}
}
